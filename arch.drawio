                <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n  User[\&quot;Operator / requester&lt;br&gt;Drive, command, confirm release\&quot;]\n\n  subgraph Client[\&quot;Operator devices\&quot;]\n    UI[\&quot;Web / phone UI\&quot;]\n    Gamepad[\&quot;Gamepad\&quot;]\n    Keyboard[\&quot;Keyboard\&quot;]\n  end\n\n  subgraph Workstation[\&quot;GPU workstation\&quot;]\n    Gateway[\&quot;UI gateway and control ownership\&quot;]\n    Modes[\&quot;Mode manager&lt;br&gt;Disabled, Manual, Autonomous, Fault\&quot;]\n    Safety[\&quot;Safety supervisor&lt;br&gt;Deadman, limits, watchdog, keep-out zones\&quot;]\n    BT[\&quot;Behavior tree&lt;br&gt;Relocalize → navigate → find → grasp → return → handoff\&quot;]\n    Task[\&quot;Language and semantic task planner\&quot;]\n    Global[\&quot;Global planner\&quot;]\n    Local[\&quot;Local navigation controller\&quot;]\n    Manip[\&quot;Manipulation planner / learned policy\&quot;]\n    Servo[\&quot;Visual servo and base/lift alignment\&quot;]\n    Sync[\&quot;Sensor synchronization and health\&quot;]\n    Vision[\&quot;Detection, segmentation, depth and free space\&quot;]\n    SLAM[\&quot;Visual SLAM and global relocalization\&quot;]\n    Fusion[\&quot;Wheel-vision state estimation\&quot;]\n    Scene[\&quot;Semantic map and scene state\&quot;]\n    Models[\&quot;Large models&lt;br&gt;VLM, policies, detectors\&quot;]\n    ROS[\&quot;Shared ROS 2 interfaces&lt;br&gt;Topics, actions, services, TF\&quot;]\n    Viz[\&quot;Visualization and diagnostics&lt;br&gt;RViz, Foxglove, camera views, faults\&quot;]\n    Logs[\&quot;ROS bags / LeRobot episodes&lt;br&gt;Metrics, replay, failure codes\&quot;]\n  end\n\n  subgraph Twin[\&quot;Digital twin on workstation\&quot;]\n    Gazebo[\&quot;Gazebo Harmonic&lt;br&gt;Primary integration simulator\&quot;]\n    MuJoCo[\&quot;MuJoCo&lt;br&gt;Optional fast manipulation training\&quot;]\n    SimRobot[\&quot;Robot model&lt;br&gt;Omni base, lift, dual arms, grippers, 5 RGB cameras\&quot;]\n    SimWorld[\&quot;Mapped house&lt;br&gt;Kitchen, countertop, apple, requester\&quot;]\n    Factory[\&quot;Episode factory&lt;br&gt;Randomization, failures, automatic reset\&quot;]\n    Oracle[\&quot;Privileged labels&lt;br&gt;Pose, depth, contacts, success\&quot;]\n  end\n\n  subgraph Pi[\&quot;Raspberry Pi 5 on real robot\&quot;]\n    PiBridge[\&quot;ROS hardware bridge\&quot;]\n    HWControl[\&quot;Low-level control&lt;br&gt;Wheel kinematics, joint commands, odometry\&quot;]\n    PiSafety[\&quot;Independent safety layer&lt;br&gt;Command timeout, limits, fault latch\&quot;]\n  end\n\n  subgraph Robot[\&quot;Physical AlohaMini\&quot;]\n    Cameras[\&quot;5 RGB cameras&lt;br&gt;Front, rear, top, two wrists\&quot;]\n    Encoders[\&quot;Wheel and joint encoders\&quot;]\n    Actuators[\&quot;3-wheel omni base&lt;br&gt;Lift, two arms, grippers\&quot;]\n    EStop[\&quot;Physical E-stop\&quot;]\n  end\n\n  User --&gt; UI\n  User --&gt; Gamepad\n  User --&gt; Keyboard\n  UI --&gt; Gateway\n  Gamepad --&gt; Gateway\n  Keyboard --&gt; Gateway\n  Gateway --&gt; Modes\n  Modes --&gt; Safety\n  Gateway --&gt; Task\n  Task --&gt; BT\n  BT --&gt; Global\n  BT --&gt; Local\n  BT --&gt; Manip\n  BT --&gt; Servo\n  Models --&gt; Vision\n  Models --&gt; Local\n  Models --&gt; Manip\n  Sync --&gt; Vision\n  Vision --&gt; SLAM\n  Vision --&gt; Scene\n  SLAM --&gt; Fusion\n  Fusion --&gt; Global\n  Scene --&gt; Global\n  Global --&gt; Local\n  Scene --&gt; Manip\n  Safety --&gt; ROS\n  Local --&gt; ROS\n  Manip --&gt; ROS\n  Servo --&gt; ROS\n  ROS &lt;--&gt;|Simulation mode, same interfaces| Gazebo\n  Gazebo --&gt; SimRobot\n  Gazebo --&gt; SimWorld\n  Factory --&gt; Gazebo\n  Gazebo -.-&gt;|Training and scoring only| Oracle\n  Oracle -.-&gt; Models\n  MuJoCo -.-&gt; Models\n  ROS &lt;--&gt;|Real mode, Ethernet / Wi-Fi| PiBridge\n  PiBridge --&gt; HWControl\n  HWControl --&gt; PiSafety\n  PiSafety --&gt; Actuators\n  Cameras --&gt; PiBridge\n  Encoders --&gt; PiBridge\n  EStop --&gt; PiSafety\n  ROS --&gt; Viz\n  ROS --&gt; Logs\n  Gazebo --&gt; Viz\n  PiBridge --&gt; Viz\n  Logs -.-&gt; Models&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="90">
