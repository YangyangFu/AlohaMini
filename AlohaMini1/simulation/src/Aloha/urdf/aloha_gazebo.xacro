<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="wheel_rolling_friction" value="5.0" />
  <xacro:property name="wheel_lateral_friction" value="0.01" />

  <xacro:macro name="aloha_gazebo" params="controllers_file">
    <!-- An omni wheel needs strong rolling-direction traction and low lateral
         resistance to approximate its passive rollers. fdir1 is expressed in
         each wheel collision's local frame; +X is the rolling direction. -->
    <gazebo reference="wheel1">
      <mu1>${wheel_rolling_friction}</mu1>
      <mu2>${wheel_lateral_friction}</mu2>
      <fdir1>1 0 0</fdir1>
    </gazebo>
    <gazebo reference="wheel2">
      <mu1>${wheel_rolling_friction}</mu1>
      <mu2>${wheel_lateral_friction}</mu2>
      <fdir1>1 0 0</fdir1>
    </gazebo>
    <gazebo reference="wheel3">
      <mu1>${wheel_rolling_friction}</mu1>
      <mu2>${wheel_lateral_friction}</mu2>
      <fdir1>1 0 0</fdir1>
    </gazebo>

    <gazebo>
      <plugin filename="gz_ros2_control-system"
              name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>${controllers_file}</parameters>
      </plugin>
    </gazebo>
  </xacro:macro>
</robot>
