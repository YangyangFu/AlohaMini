# X11 variant: renders into a native window on the host X server (XQuartz on
# macOS, the local X server on Linux) instead of streaming through KasmVNC.
# No VNC stack is installed, so this image is smaller than the default one.
FROM ros:jazzy-ros-base

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    mesa-utils \
    python3-pil \
    python3-colcon-common-extensions \
    ros-jazzy-controller-manager \
    ros-jazzy-gz-ros2-control \
    ros-jazzy-joint-state-publisher \
    ros-jazzy-joint-state-publisher-gui \
    ros-jazzy-robot-state-publisher \
    ros-jazzy-rosbridge-server \
    ros-jazzy-ros-gz-bridge \
    ros-jazzy-ros-gz-sim \
    ros-jazzy-ros2-control \
    ros-jazzy-ros2-controllers \
    ros-jazzy-rviz2 \
    ros-jazzy-xacro \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /aloha_ws
COPY src ./src
COPY docker ./docker

RUN . /opt/ros/jazzy/setup.sh \
    && colcon build --symlink-install \
    && chmod +x /aloha_ws/docker/entrypoint.sh

ENTRYPOINT ["/aloha_ws/docker/entrypoint.sh"]
CMD ["ros2", "launch", "aloha", "gazebo.launch.py", "gui:=true"]
